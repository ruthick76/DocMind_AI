# Copy to backend/.env. Never commit actual keys.
DOCMIND_API_KEY=
# Optional separate credentials; each falls back to DOCMIND_API_KEY.
DOCMIND_LLM_API_KEY=
DOCMIND_EMBEDDING_API_KEY=
DOCMIND_LLM_BASE_URL=https://api.openai.com/v1
DOCMIND_EMBEDDING_BASE_URL=https://api.openai.com/v1
DOCMIND_LLM_MODEL=gpt-4o-mini
DOCMIND_EMBEDDING_MODEL=text-embedding-3-small
# Relative DATA_DIR is resolved against backend/, regardless of current directory.
DOCMIND_DATA_DIR=data
DOCMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DOCMIND_MAX_UPLOAD_MB=10
DOCMIND_CHUNK_SIZE=1000
DOCMIND_CHUNK_OVERLAP=150
DOCMIND_TOP_K=5
DOCMIND_MIN_SIMILARITY=0.25
DOCMIND_REQUEST_TIMEOUT=45
